# Skopiuj ten plik jako .env i w razie potrzeby zmień wartości.
POSTGRES_USER=kd
POSTGRES_PASSWORD=zmien_mnie
POSTGRES_DB=kd
DB_PORT=5432

# Adres bazy dla API, importu i testów uruchamianych lokalnie (poza Dockerem).
# 127.0.0.1 zamiast localhost: na Windowsie localhost potrafi wisieć na IPv6.
# Jeśli port 5432 jest zajęty lub zablokowany, zmień DB_PORT i port w DATABASE_URL (np. 5433).
# W kontenerze API adres ustawia docker-compose.yml (host db, nazwa usługi bazy).
DATABASE_URL=postgresql://kd:zmien_mnie@127.0.0.1:5432/kd